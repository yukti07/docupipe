# Copy to terraform.tfvars and fill in. None of these are secrets — the
# database password and the session key are generated by Terraform and go
# straight to Secret Manager without passing through a file or a chat.

project_id     = "your-gcp-project-id"
project_number = "123456789012"
region         = "asia-south1"
env            = "dev"

# Vercel OIDC. Both are team-scoped and must match the Vercel dashboard
# exactly — a mismatch fails at request time with an opaque STS error.
vercel_team_slug    = "your-team-slug"
vercel_project_name = "your-project-name"

# GCS matches origins as exact strings or "*" — no partial wildcards, so
# preview deployments need "*". That is acceptable: the signed URL is the
# security boundary, not CORS.
cors_origins = ["*"]
# Production:
# cors_origins = ["https://quarry.example.com", "http://localhost:3000"]

# Cloud Monitoring channel ids. An alert policy with no channel is a
# dashboard nobody looks at, so the policies are skipped when this is empty.
alert_notification_channels = []

# db_deletion_protection = true   # for anything anyone cares about
