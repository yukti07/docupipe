# Which role this process runs as. One image, two deployments (§26).
SERVICE_ROLE=inspect

# --- database -------------------------------------------------------------
# Local / cloud-sql-proxy: a plain URL.
DATABASE_URL=postgresql://quarry:quarry@localhost:5432/quarry
# Cloud Run: leave DATABASE_URL empty and set these instead. The worker
# connects over the platform's built-in proxy socket at /cloudsql/<instance>.
INSTANCE_CONNECTION_NAME=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_POOL_SIZE=2

# --- storage --------------------------------------------------------------
# local = a directory on disk, so docker compose needs no cloud account.
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=/var/quarry/storage
GCS_BUCKET_NAME=

# --- pub/sub --------------------------------------------------------------
GCP_PROJECT_ID=
PUBSUB_TOPIC_FILE_UPLOADED=file-uploaded
PUBSUB_TOPIC_CONVERT_REQUESTED=convert-requested

# --- leasing --------------------------------------------------------------
# The lease must be longer than the work, and the Pub/Sub ack deadline at
# least as long as the lease, or a healthy worker gets its file stolen.
LEASE_SECONDS=600
MAX_ATTEMPTS=5
OUTBOX_MAX_ATTEMPTS=10

LOG_LEVEL=INFO
GIT_SHA=dev
