# Copy to .env for local Docker use. Never commit .env.
ZAMP_GCP_PROJECT_ID=your-gcp-project-id
POSTGRES_PASSWORD=zamp-local-only
ZAMP_DATABASE_URL=postgresql+psycopg://zamp:zamp-local-only@postgres:5432/zamp

# Image and document schema detection through Gemini.
ZAMP_LLM_ENABLED=true
ZAMP_LLM_PROVIDER=gemini
ZAMP_LLM_MODEL=gemini-3.6-flash
ZAMP_LLM_API_KEY=your-google-ai-studio-key
# Only needed outside the container, where the working directory is the Zamp
# root rather than /app.
ZAMP_SCHEMA_PROMPTS_DIR=python/prompts
